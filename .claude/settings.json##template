{
{% if yadm.os == "Darwin" %}
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
{% endif %}
  "permissions": {
    "allow": [
{% if yadm.os == "Msys" %}
      "Bash(powershell:*)",
{% endif %}
{% if yadm.os == "Linux" %}
      "Read(/home/garyo/Downloads)",
      "Edit(/tmp)",
      "Edit(/home/garyo/src)",
{% endif %}
      "WebSearch",
      "WebFetch",
      "Bash(awk:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(docker:*)",
      "Bash(echo:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ln:*)",
      "Bash(ls:*)",
      "Bash(make:*)",
      "Bash(mv:*)",
      "Bash(ninja:*)",
      "Bash(npm:*)",
      "Bash(otool:*)",
      "Bash(pcons:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(uv:*)",
      "Bash(xargs:*)",
      "Search(*)",
      "Update(*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}
