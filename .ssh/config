# Client servers and hosts with private details are in config.d, which yadm
# stores only encrypted (see ~/.config/yadm/encrypt).
Include config.d/*

Host mac-ci-runner1
  user garyoberbrunner
  ForwardAgent yes
Host freenas
  HostName freenas
  user garyo
  ForwardAgent yes
# ER-X has old OpenSSH with no post-quantum kex; silence the client warning
Host router router.home.oberbrunner.com 192.168.0.1
  WarnWeakCrypto no

# Hopefully this will silence all old-server "no post-quantum key exchange" warnings
Host *
  WarnWeakCrypto no
